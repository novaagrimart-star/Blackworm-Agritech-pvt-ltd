rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. GLOBAL HELPERS
    function isSignedIn() {
      return request.auth != null;
    }

    function isManager() {
      return isSignedIn() && (
        request.auth.token.email == 'novaagrimart@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner']
      );
    }

    function isOwner(resourceData) {
      return isSignedIn() && (
        resourceData.ownerId == request.auth.uid ||
        resourceData.createdBy == request.auth.uid ||
        isManager()
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default catch-all: reject unknown
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check
    match /test/{docId} {
      allow read, write: if true;
    }

    // 2. USER PROFILES
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (userId == request.auth.uid || isManager());
      allow delete: if isManager();
    }

    // 3. FARMERS
    match /farmers/{farmerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (isOwner(resource.data) || isManager());
    }

    // 4. ORDERS & COLLECTIONS
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (isOwner(resource.data) || isManager());
    }

    // 5. TARGETS
    match /targets/{targetId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isManager();
    }

    // 6. TRAVEL RECORDS
    match /travel_records/{travelId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (isOwner(resource.data) || isManager());
    }

    // 7. DEALERS
    match /dealers/{dealerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isManager();
    }

    // 8. PRODUCTS
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManager();
    }

    // 9. SCHEMES
    match /schemes/{schemeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManager();
    }

    // 10. AUDIT LOGS (Append-only)
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 11. DELETED RECORDS (Soft-Delete Recycle Bin)
    match /deleted_records/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn();
      allow update: if false;
    }
  }
}
